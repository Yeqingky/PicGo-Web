# ---- 运行时数据（绝不提交）----
data/
data-dev/
*.db
*.db-shm
*.db-wal
secret.key
agent-token.txt
initial-admin-password.txt

# ---- 构建产物 ----
server/picgo-web
server/bin/
picgo-agent/dist/
picgo-agent/node_modules/
web/dist/
web/node_modules/
themes/

# 内置 SPA 的 embed 目录：由 `make build-web` 从 web/dist 同步进来。
# 只保留 .gitkeep（保证 `//go:embed all:dist` 在未构建前端时也能编译）。
server/internal/webfs/dist/*
!server/internal/webfs/dist/.gitkeep

# ---- 环境 ----
.env
.env.local
.env.*.local

# ---- 编辑器 / 系统 ----
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# ---- 日志 ----
*.log
logs/

# 前端源码目录名与运行时目录重名，必须显式保留源码。
!web/src/components/themes/
!web/src/components/themes/**
!web/src/features/admin/logs/
!web/src/features/admin/logs/**
!web/src/features/admin/themes/
!web/src/features/admin/themes/**
!web/src/features/logs/
!web/src/features/logs/**

# ---- Go ----
*.test
coverage.out

# ---- Node ----
.pnpm-store/
*.tsbuildinfo
.eslintcache
