# PicGo-Web 开发镜像（配合 docker-compose-dev.yml）
#
# 与生产 Dockerfile 的差异：
#   · 只装依赖、**不构建**产物（源码由 compose 以卷挂载，改代码即热重载）
#   · 保留 devDependencies（tsx / vite / tsc 都需要）
#   · 提供三个 target，供 compose 分别选：
#       agent-dev    Node 24（tsx watch 跑 picgo-agent）
#       server-dev   Go 1.25（go run 跑 server，含 go 工具链缓存卷）
#       web-dev      Node 24（vite dev server，HMR）
#
# ⚠️ 构建上下文是**仓库根目录**（需要 picgo-agent/、web/、server/）：
#     docker compose -f docker-compose-dev.yml build
#
# picgo-core 从 npm 取 `@yeqingky/picgo-core`，**不需要**本地 PicGo-Core 源码。

# ===========================================================================
# agent-dev：Node + tsx watch
# ===========================================================================
FROM node:24-alpine AS agent-dev
WORKDIR /app/picgo-agent

RUN corepack enable

# 先只拷清单，利用 layer 缓存（源码变动不需要重装依赖）
COPY picgo-agent/package.json picgo-agent/pnpm-lock.yaml ./
# --frozen-lockfile=false：lockfile 里若有本地 file: 依赖的历史残留也能装上；
# 正常情况 lockfile 已指向 npm 包，frozen 也能过。
RUN pnpm install --frozen-lockfile=false

# 源码由 compose 卷挂载覆盖，这里拷一份作为「未挂载时也能跑」的兜底
COPY picgo-agent/ ./

# 默认命令：tsx watch（改 TS 自动重启）
CMD ["pnpm", "dev"]


# ===========================================================================
# server-dev：Go + go run
# ===========================================================================
FROM golang:1.25-alpine AS server-dev
WORKDIR /app/server

# 纯 Go：SQLite 用 glebarez/sqlite、PgSQL 用 pgx，都不需要 CGO
ENV CGO_ENABLED=0 \
    GOFLAGS=-mod=mod \
    GOTOOLCHAIN=local

# 时区与证书：调图床 / GitHub OAuth / ACG API 需要
RUN apk add --no-cache ca-certificates tzdata

# 依赖缓存（卷挂载 /go/pkg/mod 后可复用）
COPY server/go.mod server/go.sum ./
RUN go mod download

# 源码由 compose 卷挂载
COPY server/ ./

# web/dist 供 webfs 的 go:embed 使用。
#
# ⚠️ `go:embed all:dist` 要求目录**必须存在**（哪怕只有占位文件），
#    否则 `go build` 直接编译失败。仓库里已有 dist/.gitkeep 保证这点；
#    这里再兜底创建一次，避免有人清理过 dist 后容器起不来。
RUN mkdir -p internal/webfs/dist && \
    [ -f internal/webfs/dist/.gitkeep ] || touch internal/webfs/dist/.gitkeep

EXPOSE 8080
CMD ["go", "run", "./cmd/picgo-web"]


# ===========================================================================
# web-dev：Node + Vite dev server（HMR）
# ===========================================================================
FROM node:24-alpine AS web-dev
WORKDIR /app/web

RUN corepack enable

COPY web/package.json web/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile=false

COPY web/ ./

EXPOSE 5173
# --host 0.0.0.0：容器外才能访问；Vite 默认只绑 127.0.0.1
CMD ["pnpm", "dev", "--host", "0.0.0.0"]


# ===========================================================================
# e2e：端到端验证专用（同时需要 Go 与 Node 两套工具链）
# ===========================================================================
#
# 为什么单独一个 target：`scripts/e2e-*.sh` 要做三件事：
#   1. 构建 Go 二进制（验证真实服务）
#   2. 构建 picgo-agent（侧车要跑起来）
#   3. 用 node 起本地 mock 图床与 mock 插件
# 因此它既需要 go 又需要 node —— 复用 server-dev 或 web-dev 都缺一半。
#
# 用法（通过 compose，见 Makefile 的 e2e-* 目标）：
#   docker compose -f docker-compose-dev.yml run --rm --no-deps e2e ./scripts/e2e-lsky.sh
FROM golang:1.25-alpine AS e2e
WORKDIR /app

ENV CGO_ENABLED=0 \
    GOFLAGS=-mod=mod \
    GOTOOLCHAIN=local

# 脚本依赖：bash（不是 ash）、curl、python3（解析 JSON 断言）、node/npm（mock 图床与插件）
# corepack 用于启用 pnpm
RUN apk add --no-cache bash curl python3 nodejs npm ca-certificates tzdata
RUN corepack enable && corepack prepare pnpm@latest --activate

# 三端源码（由 compose 卷挂载覆盖，这里拷一份作为构建期兜底）
COPY server/ /app/server/
COPY picgo-agent/ /app/picgo-agent/
COPY web/ /app/web/
COPY scripts/ /app/scripts/
COPY Makefile /app/

RUN chmod +x /app/scripts/*.sh

CMD ["bash"]
