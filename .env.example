# ============================================================================
# PicGo-Web 环境变量示例（生产：docker compose up -d）
#
# ⚠️ 只有「启动引导类」配置走环境变量（见 docs/DECISIONS.md D18 三级分层）。
#    其余全部业务配置（站点信息、上传限制、SMTP、OAuth、限流、日志保留…）
#    都在**后台界面**里改，存在数据库的 SystemSettings 表里。
#
# ⚠️ 部署方式：本项目**只提供 docker compose**。
#      · 生产  docker compose up -d
#      · 开发  make dev        （= docker compose -f docker-compose-dev.yml up）
#
# 用法：cp .env.example .env 后按需修改。
# 优先级：已存在的同名环境变量 > .env 文件 > 镜像内默认值。
# ============================================================================

# ---------------------------------------------------------------------------
# 服务
# ---------------------------------------------------------------------------
# HTTP 监听地址（容器内）。
# ⚠️ 必须是 0.0.0.0:8080，否则宿主机映射的端口访问不到。
PICGO_WEB_LISTEN=0.0.0.0:8080

# 数据目录（容器内路径；数据库 / 主密钥 / 上传暂存 / picgo 配置 / 主题 都在这里）
# ⚠️ 容器内固定 /data（对应 compose 里挂载的 ./data:/data）。
#    改成别的路径会导致数据不落盘到宿主。
PICGO_WEB_DATA_DIR=/data

# 日志级别：debug | info | warn | error
PICGO_WEB_LOG_LEVEL=info

# 开发模式（true 时使用文本日志 + gin debug 模式）
# 开发环境由 docker-compose-dev.yml 自动设为 true，生产保持 false
PICGO_WEB_DEV=false

# 是否信任反向代理传来的客户端 IP 头（X-Forwarded-For / X-Real-IP）
#
# ⚠️ 默认 false。只有在前置了**可信**反向代理时才开启，
#    否则客户端可伪造 IP 绕过登录失败限流。
PICGO_WEB_TRUST_PROXY=false

# ---------------------------------------------------------------------------
# 安全
# ---------------------------------------------------------------------------
# 加密主密钥（AES-256-GCM）。用于加密库中的敏感配置（SMTP 密码、OAuth secret、
# 存储驱动凭据）。
#
# 留空 → 首次启动自动生成 <DATA_DIR>/secret.key（权限 0600）。
# 容器环境推荐用环境变量注入，避免把密钥留在数据卷里。
#
# 格式：64 位十六进制 / base64（32 字节）/ 原样 32 字节字符串。
#
# ⚠️ 丢失后已加密的配置**无法恢复**，必须重新填写。
PICGO_WEB_SECRET_KEY=

# ---------------------------------------------------------------------------
# 数据库
# ---------------------------------------------------------------------------
# 数据库驱动：sqlite（默认，纯 Go 免 CGO）| postgres
PICGO_WEB_DB_DRIVER=sqlite

# 完整 DSN。**非空时完全覆盖**下面的分项配置（便于使用云厂商托管连接串）
PICGO_WEB_DB_DSN=

# 是否在启动时自动执行数据库迁移。生产环境建议保持 true
PICGO_WEB_DB_AUTO_MIGRATE=true

# --- SQLite（driver=sqlite 时生效）---
# 留空 → <DATA_DIR>/picgo-web.db
PICGO_WEB_SQLITE_PATH=

# --- PostgreSQL（driver=postgres 时生效）---
PICGO_WEB_PG_HOST=127.0.0.1
PICGO_WEB_PG_PORT=5432
PICGO_WEB_PG_USER=
PICGO_WEB_PG_PASSWORD=
PICGO_WEB_PG_DBNAME=
# disable | allow | prefer | require | verify-ca | verify-full
# 生产环境建议 require 及以上
PICGO_WEB_PG_SSLMODE=disable
PICGO_WEB_PG_TIMEZONE=Asia/Shanghai

# --- 连接池（两方言共用）---
PICGO_WEB_DB_MAX_OPEN_CONNS=25
PICGO_WEB_DB_MAX_IDLE_CONNS=5
PICGO_WEB_DB_CONN_MAX_LIFETIME=1h

# ---------------------------------------------------------------------------
# picgo-agent 侧车（Node 进程，持有 picgo-core）
# ---------------------------------------------------------------------------
# agent 地址（仅监听 127.0.0.1）
PICGO_WEB_AGENT_URL=http://127.0.0.1:36678

# 与 agent 之间的共享令牌。留空 → 首次启动随机生成并写入
# <DATA_DIR>/agent-token.txt（0600）；Go 拉起 agent 时通过环境变量注入
PICGO_WEB_AGENT_TOKEN=

# 是否由 Go 自动拉起 agent 子进程。
#
# ⚠️ 生产**保持 true**：令牌生成、健康探测、退避重启、优雅关停都在 Go 里
#    （internal/agent/lifecycle.go，有测试覆盖）。
#    开发环境由 docker-compose-dev.yml 设为 false —— 那里 agent 是独立容器。
PICGO_WEB_AGENT_AUTOSTART=true

# 使用 mock agent（不依赖 Node 进程，仅用于前端联调）
PICGO_WEB_AGENT_MOCK=false

# ---------------------------------------------------------------------------
# 上传安全
# ---------------------------------------------------------------------------
# 「从 URL 上传」时是否允许抓取私有网段 / 回环地址（SSRF 防护开关）
# ⚠️ 默认 false。只有在内网图床场景才开启。
PICGO_WEB_ALLOW_PRIVATE_FETCH=false

# ---------------------------------------------------------------------------
# 静态资源与主题
# ---------------------------------------------------------------------------
# 内置 SPA 的产物目录。留空 → 使用编译进二进制的 embed 资源（推荐）
PICGO_WEB_STATIC_DIR=

# 主题根目录。留空 → <DATA_DIR>/themes
PICGO_WEB_THEMES_DIR=

# 主题 seed 源目录。留空 → 使用二进制内嵌的默认主题（推荐）
# 首次启动若主题目录为空，会把 seed 源复制过去
PICGO_WEB_THEME_SEED=
